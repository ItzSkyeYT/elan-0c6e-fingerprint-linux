# NEVER commit biometric data — fingerprint captures stay local.
*.pgm
*.pnm
finger.*
fp_raw_*
fp_f*_*
fp_enhanced_*
fp_scaled_*

# build artefacts
*.pkg.tar.zst
*.log
src/
pkg/
build/

# --- biometric data: NEVER commit anything derived from a capture ---
# Fingerprint minutiae templates are biometric data in their own right --
# arguably more sensitive than the images, since they are the matchable form.
*.xyt
*.min
*.wsq
*.raw
# Numpy caches from the experiments hold image patches and descriptor sets
# computed directly from captures.
*.npy
*.npz
# Montages / renders of captures
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
# Compiled artefacts
__pycache__/
*.pyc
# Compiled binaries from the NBIS experiment
tools/exp-nbis/nbisbatch
tools/exp-nbis/mdt
