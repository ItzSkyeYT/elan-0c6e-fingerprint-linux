diff --git a/libfprint/drivers/elan.c b/libfprint/drivers/elan.c
index 1b5d1e70..e50e84eb 100644
--- a/libfprint/drivers/elan.c
+++ b/libfprint/drivers/elan.c
@@ -314,15 +314,94 @@ elan_submit_image (FpImageDevice *dev)
 
   G_DEBUG_HERE ();
 
-  raw_frames = g_slist_nth (self->frames, ELAN_SKIP_LAST_FRAMES);
+  /* 0x0c6e is a press sensor — no lifting artifacts, keep all frames */
+  int skip = (self->dev_type & ELAN_0C6E) ? 0 : ELAN_SKIP_LAST_FRAMES;
+  raw_frames = g_slist_nth (self->frames, skip);
 
   assembling_ctx.frame_width = self->frame_width;
   assembling_ctx.frame_height = self->frame_height;
-  assembling_ctx.image_width = self->frame_width * 3 / 2;
-  g_slist_foreach (raw_frames, (GFunc) self->process_frame, &frames);
-  fpi_do_movement_estimation (&assembling_ctx, frames);
-  img = fpi_assemble_frames (&assembling_ctx, frames);
-  img->flags |= FPI_IMAGE_PARTIAL;
+
+  if (self->dev_type & ELAN_0C6E)
+    {
+      /* Press sensor: average all captured frames for better SNR, then submit
+       * as a single complete image without swipe assembly.
+       * Using image_width = frame_width avoids the black side-borders that the
+       * swipe assembler adds (frame_width * 3/2), which cause minutiae detection
+       * to fail on a full-press image. */
+      unsigned int frame_size = self->frame_width * self->frame_height;
+      guint32 *avg = g_malloc0 (frame_size * sizeof (guint32));
+      int n = 0;
+
+      for (GSList *l = raw_frames; l != NULL; l = l->next, n++)
+        {
+          unsigned short *f = l->data;
+          for (unsigned int i = 0; i < frame_size; i++)
+            avg[i] += f[i];
+        }
+
+      unsigned short *avg_frame = g_malloc (frame_size * sizeof (unsigned short));
+      for (unsigned int i = 0; i < frame_size; i++)
+        avg_frame[i] = (n > 0) ? (unsigned short) (avg[i] / n) : 0;
+      g_free (avg);
+
+      /* Debug: show raw pixel statistics to diagnose image quality */
+      {
+        guint32 sum = 0, nonzero = 0;
+        unsigned short pmin = 0xffff, pmax = 0;
+        for (unsigned int i = 0; i < frame_size; i++)
+          {
+            if (avg_frame[i] < pmin) pmin = avg_frame[i];
+            if (avg_frame[i] > pmax) pmax = avg_frame[i];
+            sum += avg_frame[i];
+            if (avg_frame[i] > 0) nonzero++;
+          }
+        fp_dbg ("0x0c6e: averaged %d frames (%dx%d) raw: min=%u max=%u mean=%u nonzero=%u/%u",
+                n, self->frame_width, self->frame_height,
+                pmin, pmax, sum / frame_size, nonzero, frame_size);
+      }
+
+      /* Debug: save raw averaged frame as PGM for visual inspection */
+      {
+        static int dump_count = 0;
+        gchar *path = g_strdup_printf ("/tmp/fp_raw_%d.pgm", dump_count++);
+        GString *buf = g_string_new (NULL);
+        g_string_append_printf (buf, "P5\n%d %d\n255\n",
+                                self->frame_width, self->frame_height);
+        /* Scale 14-bit values to 8-bit for PGM */
+        for (unsigned int i = 0; i < frame_size; i++)
+          g_string_append_c (buf, (gchar) (avg_frame[i] >> 6));
+        g_file_set_contents (path, buf->str, buf->len, NULL);
+        fp_dbg ("0x0c6e: dumped raw frame to %s", path);
+        g_string_free (buf, TRUE);
+        g_free (path);
+      }
+
+      assembling_ctx.image_width = self->frame_width;
+      self->process_frame (avg_frame, &frames);
+      g_free (avg_frame);
+
+      /* fpi_assemble_frames expects delta_x/delta_y to be populated */
+      ((struct fpi_frame *) frames->data)->delta_x = 0;
+      ((struct fpi_frame *) frames->data)->delta_y = 0;
+
+      img = fpi_assemble_frames (&assembling_ctx, frames);
+
+      /* Set standard 500 dpi resolution so NBIS ridge-frequency and quality
+       * calculations work correctly (default ppmm=0 breaks them). */
+      img->ppmm = 19.685;
+
+      /* Mark as partial so NBIS removes unreliable perimeter minutiae —
+       * this reduces false minutiae from the image edges. */
+      img->flags |= FPI_IMAGE_PARTIAL;
+    }
+  else
+    {
+      assembling_ctx.image_width = self->frame_width * 3 / 2;
+      g_slist_foreach (raw_frames, (GFunc) self->process_frame, &frames);
+      fpi_do_movement_estimation (&assembling_ctx, frames);
+      img = fpi_assemble_frames (&assembling_ctx, frames);
+      img->flags |= FPI_IMAGE_PARTIAL;
+    }
 
   g_slist_free_full (frames, g_free);
 
@@ -590,7 +669,9 @@ capture_complete (FpiSsm *ssm, FpDevice *_dev, GError *error)
       (g_error_matches (error, G_USB_DEVICE_ERROR, G_USB_DEVICE_ERROR_TIMED_OUT) &&
        fpi_ssm_get_cur_state (ssm) == CAPTURE_WAIT_FINGER))
     {
-      if (self->num_frames >= ELAN_MIN_FRAMES)
+      /* Press sensors only need 1 frame since we're averaging, not swiping */
+      int min_frames = (self->dev_type & ELAN_0C6E) ? 1 : ELAN_MIN_FRAMES;
+      if (self->num_frames >= min_frames)
         {
           elan_submit_image (dev);
         }
@@ -677,6 +758,10 @@ enum calibrate_states {
 static gboolean
 elan_supports_calibration (FpiDeviceElan *elandev)
 {
+  /* 0x0c6e: calibration status polling is unreliable on this device */
+  if (elandev->dev_type & ELAN_0C6E)
+    return FALSE;
+
   if (elandev->dev_type == ELAN_0C42)
     return TRUE;
 
@@ -859,10 +944,13 @@ activate_run_state (FpiSsm *ssm, FpDevice *dev)
           self->frame_height++;
           self->raw_frame_height = self->frame_height;
         }
-      if (self->frame_height > ELAN_MAX_FRAME_HEIGHT)
+      /* For swipe sensors the frame is cropped to improve stitching; press
+       * sensors benefit from the full height so NBIS has more pixels. */
+      if (self->frame_height > ELAN_MAX_FRAME_HEIGHT &&
+          !(self->dev_type & ELAN_0C6E))
         self->frame_height = ELAN_MAX_FRAME_HEIGHT;
-      fp_dbg ("sensor dimensions, WxH: %dx%d", self->frame_width,
-              self->raw_frame_height);
+      fp_dbg ("sensor dimensions, WxH: %dx%d (raw_h=%d)", self->frame_width,
+              self->frame_height, self->raw_frame_height);
       fpi_ssm_next_state (ssm);
       break;
 
@@ -927,6 +1015,15 @@ dev_init (FpImageDevice *dev)
       break;
     }
 
+  if (self->dev_type & ELAN_0C6E)
+    {
+      /* Press sensor: lower the Bozorth3 match threshold.
+       * Small sensors produce fewer minutiae so raw scores are lower,
+       * but both enrollment and verify images come from the same sensor
+       * in the same way, so a lower threshold is still secure. */
+      fpi_image_device_set_bz3_threshold (dev, 20);
+    }
+
   fpi_image_device_open_complete (dev, NULL);
 }
 
diff --git a/libfprint/drivers/elan.h b/libfprint/drivers/elan.h
index 7d089945..4f9ad50e 100644
--- a/libfprint/drivers/elan.h
+++ b/libfprint/drivers/elan.h
@@ -31,6 +31,8 @@
 #define ELAN_0907 (1 << 0)
 #define ELAN_0C03 (1 << 1)
 #define ELAN_0C42 (1 << 2)
+/* 0x0c6e: calibration status polling is unreliable; skip it */
