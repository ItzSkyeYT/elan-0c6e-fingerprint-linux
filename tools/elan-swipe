# libfprint/drivers/elan.h:53
ELAN_MIN_FRAMES = 7
# libfprint/drivers/elan.h:54
ELAN_MAX_FRAMES = 30
# libfprint/drivers/elan.h:57
ELAN_MAX_FRAME_HEIGHT = 50
# libfprint/drivers/elan.h:61
ELAN_SKIP_LAST_FRAMES = 2
# libfprint/drivers/elan.h:73-74
ELAN_CMD_TIMEOUT = 10000
ELAN_FINGER_TIMEOUT = 200
# libfprint/drivers/elan.h:64-66
EP_CMD_OUT = 0x01
EP_CMD_IN = 0x83
EP_IMG_IN = 0x82

CMD_GET_SENSOR_DIM = b"\x00\x0c"   # elan.h:89
CMD_GET_FW_VER = b"\x40\x19"       # elan.h:96
CMD_GET_IMAGE = b"\x00\x09"        # elan.h:111
CMD_GET_CALIB_STATUS = b"\x40\x23"  # elan.h:127
CMD_GET_CALIB_MEAN = b"\x40\x24"   # elan.h:134
CMD_LED_ON = b"\x40\x31"           # elan.h:141
CMD_PRE_SCAN = b"\x40\x3f"         # elan.h:150
CMD_STOP = b"\x00\x0b"             # elan.h:158

DPI = 500.0
PX_PER_MM = DPI / 25.4  # 19.685

UINT32 = 0xFFFFFFFF
INT_MAX = 2147483647

