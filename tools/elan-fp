#!/usr/bin/env bash
#
# elan-fp — drive and recover an ELAN 04f3:0c6e fingerprint sensor.
#
# This sensor has several independent failure modes that each need a different
# recovery, and one of them (an infinite poll loop in the elanpress driver)
# hangs forever rather than erroring. Every operation here is therefore
# timeout-bounded, and failures escalate through a recovery ladder instead of
# giving up or blocking.
#
#   elan-fp status     what the sensor/driver/enrollment currently look like
#   elan-fp verify     verify, auto-recovering and retrying on failure
#   elan-fp enroll     enroll, unwedging first so the attempt isn't wasted
#   elan-fp test       verify 10x and report a match rate
#   elan-fp score      measure actual NCC match scores (elanpress only)
#   elan-fp impostor   measure WRONG-finger scores — decides if tuning is safe
#   elan-fp unwedge    run the recovery ladder on its own
#   elan-fp collect L  capture a labelled dataset for offline matcher work
#   elan-fp swipe      capture ONE swipe, dump the frames, judge the assembly
#   elan-fp swipe-report D   re-judge an already-captured swipe directory
#   elan-fp swipe-enroll     enroll by SWIPING, building one map of the finger
#   elan-fp swipe-test       verify by SWIPING, N times, and report a match rate
#
# `swipe` exits 0 if the assembled image passed every failure test, 2 if it
# assembled but did not, 1 if nothing assembled, 3 if the swipe driver is not
# installed.
#   elan-fp doctor     full diagnostic dump for bug reports
#
# Flags:  --debug         keep driver logs (implies manual fprintd, needs root)
#         -n N            iterations for `test` (default 10)
#         --calibrate     `swipe`: run calibration instead of skipping it
#         --max-frames N  `swipe`: override the 100-frame capture cap
#         --no-partial    `swipe`: clear FPI_IMAGE_PARTIAL (keep perimeter
#                         minutiae)
#
# https://github.com/ItzSkyeYT/elan-0c6e-fingerprint-linux

set -uo pipefail

VID=04f3
PID=0c6e
FPUSER="${SUDO_USER:-$USER}"
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/elan-fp"
VERIFY_TIMEOUT=40      # generous: user must physically touch the sensor
ENROLL_TIMEOUT=180     # enrollment needs several touches
SETTLE=2               # seconds to let the device re-enumerate
SWIPE_TIMEOUT=75       # one swipe attempt: prompt, swipe, assemble, report
# The swipe driver does real work per attempt, and the numbers below are
# measured on this machine rather than guessed.  One verify is ~8 s of waiting
# for the finger plus ~9 s of registering the strip against the map; one
# enrolment is up to 12 swipe attempts, each of which also registers against
# every swipe already accepted.  A timeout shorter than the work is
# indistinguishable from a wedge, and would send the recovery ladder after a
# device that is merely busy.
SWIPE_VERIFY_TIMEOUT=60    # prompt + swipe + assemble + match against the map
SWIPE_ENROLL_TIMEOUT=600   # up to 12 swipes, each registered against the rest

DEBUG=0; ITERATIONS=10
SWIPE_CALIBRATE=0; SWIPE_MAX_FRAMES=""; SWIPE_PARTIAL=1

if [[ -t 1 ]]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; DIM=$'\e[2m'; BOLD=$'\e[1m'; N=$'\e[0m'
else
  R=; G=; Y=; B=; DIM=; BOLD=; N=
fi
say()  { printf '%s\n' "$*"; }
ok()   { printf '%s  ✔%s %s\n' "$G" "$N" "$*"; }
bad()  { printf '%s  ✘%s %s\n' "$R" "$N" "$*"; }
warn() { printf '%s  !%s %s\n' "$Y" "$N" "$*"; }
step() { printf '%s==>%s %s\n' "$B" "$N" "$*"; }
note() { printf '%s    %s%s\n' "$DIM" "$*" "$N"; }

need_root() {
  if [[ $EUID -ne 0 ]]; then
    sudo -v || { bad "sudo required"; exit 1; }
  fi
}
as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }

# ---------------------------------------------------------------- device ----

# Re-resolved after every recovery step: re-enumeration can change the path.
find_device() {
  local d v p
  for d in /sys/bus/usb/devices/*/; do
    [[ -f "$d/idVendor" && -f "$d/idProduct" ]] || continue
    v=$(<"$d/idVendor"); p=$(<"$d/idProduct")
    if [[ $v == "$VID" && $p == "$PID" ]]; then
      printf '%s' "${d%/}"
      return 0
    fi
  done
  return 1
}

device_present() { find_device >/dev/null 2>&1; }

# Does the installed libfprint contain this string?
#
# NOTE: -a is required. Plain `strings` only scans loadable initialised
# sections and misses the GObject type name entirely.
#
# NOTE: grep -c, not grep -q. `set -o pipefail` is on, and grep -q exits as
# soon as it matches, which kills `strings` with SIGPIPE and makes the whole
# pipeline report failure — i.e. a successful match reads as "not found".
# grep -c consumes all of the input, so there is no signal.
so_has() {
  local so=/usr/lib/libfprint-2.so.2 hit
  [[ -r $so ]] || return 1
  hit=$(strings -a "$so" 2>/dev/null | grep -c -- "$1")
  (( hit > 0 ))
}

current_driver() {
  # Most authoritative: ask the running driver what it calls itself.
  # elan  -> "ElanTech Fingerprint Sensor"
  # press -> "ElanTech press-type fingerprint sensor (press)"
  local name
  name=$(timeout 10 fprintd-list "$FPUSER" 2>/dev/null | sed -n 's/.* on \(.*\):$/\1/p' | head -1)
  if [[ -n $name ]]; then
    case ${name,,} in
      *press*) printf 'elanpress'; return ;;
      *elan*)  printf 'elan';      return ;;
    esac
  fi

  # Fallback when nothing is enrolled: inspect the library.
  local so=/usr/lib/libfprint-2.so.2
  if so_has FpiDeviceElanPress; then
    printf 'elanpress'
  elif [[ -r $so ]]; then
    printf 'elan'
  else
    printf 'unknown'
  fi
}

enrolled_fingers() {
  timeout 15 fprintd-list "$FPUSER" 2>/dev/null \
    | sed -n 's/^ - #[0-9]*: //p'
}

# -------------------------------------------------------------- recovery ----

kill_fprintd() {
  as_root systemctl stop fprintd 2>/dev/null
  as_root pkill -x fprintd 2>/dev/null
  sleep 1
  return 0
}

# Level 2: USB selective suspend. Closest thing to a power cycle reachable
# from software — clocks stop, and the MCU may reinitialise on resume.
# NOTE: a udev rule pinning power/control=on will defeat this; we override
# it for the duration and restore afterwards.
usb_suspend_cycle() {
  local dev; dev=$(find_device) || return 1
  local prev_ctl prev_delay
  prev_ctl=$(cat "$dev/power/control" 2>/dev/null || echo on)
  prev_delay=$(cat "$dev/power/autosuspend_delay_ms" 2>/dev/null || echo -1000)

  as_root sh -c "echo auto > '$dev/power/control'" 2>/dev/null
  as_root sh -c "echo 500  > '$dev/power/autosuspend_delay_ms'" 2>/dev/null

  local waited=0 status=
  while (( waited < 6 )); do
    sleep 1; waited=$((waited + 1))
    status=$(cat "$dev/power/runtime_status" 2>/dev/null)
    [[ $status == suspended ]] && break
  done

  # Restore the caller's policy before returning, whatever happened.
  as_root sh -c "echo '$prev_ctl'   > '$dev/power/control'" 2>/dev/null
  as_root sh -c "echo '$prev_delay' > '$dev/power/autosuspend_delay_ms'" 2>/dev/null
  sleep "$SETTLE"

  [[ $status == suspended ]]
}

# Level 3: deauthorize/reauthorize — forces full re-enumeration. Logical only,
# VBUS is untouched, so this clears kernel-side state but not firmware state.
usb_reauthorize() {
  local dev; dev=$(find_device) || return 1
  as_root sh -c "echo 0 > '$dev/authorized'" 2>/dev/null || return 1
  sleep 1
  as_root sh -c "echo 1 > '$dev/authorized'" 2>/dev/null || return 1
  sleep "$SETTLE"
  device_present
}

# Escalating ladder. $1 = level to reach (1-3).
unwedge() {
  local level="${1:-3}"

  step "Recovery level 1: clearing fprintd state"
  kill_fprintd
  ok "fprintd stopped, stale claims released"
  (( level < 2 )) && return 0

  step "Recovery level 2: USB selective suspend/resume"
  if usb_suspend_cycle; then
    ok "device entered suspend and resumed"
  else
    warn "device would not enter suspend (a udev rule or active claim may block it)"
  fi
  (( level < 3 )) && return 0

  step "Recovery level 3: USB re-enumeration"
  if usb_reauthorize; then
    ok "device re-enumerated"
  else
    bad "re-enumeration failed — device may have vanished from the bus"
    return 1
  fi
  return 0
}

# ------------------------------------------------------------ operations ----

# Runs a fprintd command under timeout, classifying the outcome.
# Echoes one of: match | no-match | hang | error | no-prints
# Full output goes to the file named by $2.
run_fprintd() {
  local cmd_timeout="$1" outfile="$2"; shift 2
  local rc=0
  timeout "$cmd_timeout" "$@" >"$outfile" 2>&1 || rc=$?

  if (( rc == 124 )); then printf 'hang'; return; fi
  if grep -q "verify-match" "$outfile" 2>/dev/null; then printf 'match'; return; fi
  if grep -q "enroll-completed" "$outfile" 2>/dev/null; then printf 'match'; return; fi
  if grep -q "verify-no-match" "$outfile" 2>/dev/null; then printf 'no-match'; return; fi
  if grep -qi "NoEnrolledPrints\|no.*enrolled" "$outfile" 2>/dev/null; then printf 'no-prints'; return; fi
  printf 'error'
}

# fprintd.service sets PrivateTmp=yes and is started on demand by D-Bus, so
# driver-level fp_dbg() output is awkward to reach. Running the daemon by hand
# with G_MESSAGES_DEBUG=all sidesteps both.
DBG_LOG=""
start_debug_daemon() {
  mkdir -p "$LOGDIR"
  # Timestamped: a fixed name gets truncated by the next run, destroying the
  # previous session's scores.
  DBG_LOG="$LOGDIR/driver-$(date +%Y%m%d-%H%M%S).log"
  kill_fprintd
  as_root sh -c "LC_ALL=C G_MESSAGES_DEBUG=all /usr/lib/fprintd -t > '$DBG_LOG' 2>&1 &"
  sleep 2
  [[ -e $DBG_LOG ]]
}
stop_debug_daemon() {
  as_root pkill -x fprintd 2>/dev/null
  [[ -n $DBG_LOG ]] && as_root chown "$(id -u):$(id -g)" "$DBG_LOG" 2>/dev/null
  return 0
}

# Collect N scores into the file named by $1. Shared by score/impostor.
collect_scores() {
  local outfile="$1" i result s threshold="" seen=0 now=0
  : > "$outfile"
  : > "$LOGDIR/genuine.txt"
  start_debug_daemon || { bad "could not start fprintd with debug"; return 1; }
  trap 'stop_debug_daemon' EXIT

  for ((i = 1; i <= ITERATIONS; i++)); do
    printf '  %2d/%d ... ' "$i" "$ITERATIONS"
    result=$(run_fprintd "$VERIFY_TIMEOUT" "$LOGDIR/attempt-$i.log" fprintd-verify "$FPUSER")
    # Only accept a score if the driver emitted a NEW line this attempt;
    # otherwise tail -1 silently repeats the previous attempt's value.
    now=$(grep -ac "NCC" "$DBG_LOG" 2>/dev/null || echo 0)
    if (( now > seen )); then
      s=$(grep -a "NCC" "$DBG_LOG" 2>/dev/null | tail -1 \
          | grep -oE "NCC [0-9]+[.,][0-9]+" | awk '{print $2}' | tr ',' '.')
    else
      s=""
    fi
    seen=$now
    if [[ -n $s ]]; then
      printf '%s\n' "$s" >> "$outfile"
      case $result in
        match) printf '%sNCC %s  match%s\n'    "$G" "$s" "$N" ;;
        *)     printf '%sNCC %s  no-match%s\n' "$Y" "$s" "$N" ;;
      esac
    else
      printf '%s%s (no score logged)%s\n' "$R" "$result" "$N"
    fi
  done
  stop_debug_daemon; trap - EXIT
  [[ -s $outfile ]]
}

stats_of() {
  LC_ALL=C awk '{v[NR]=$1; t+=$1; if($1>mx)mx=$1; if(mn==""||$1<mn)mn=$1}
    END {if(NR==0){print "0 0 0 0";exit} m=t/NR
         for(i=1;i<=NR;i++) sd+=(v[i]-m)^2
         printf "%d %.3f %.3f %.3f %.3f", NR, m, sqrt(sd/NR), mx, mn}' "$1"
}

# Present a DIFFERENT finger against the existing template. Those scores are
# the impostor distribution -- the only thing that makes a threshold choice
# defensible rather than wishful.
do_impostor() {
  local gen="$LOGDIR/genuine.txt" imp="$LOGDIR/impostor.txt"
  if [[ ! -s $gen ]]; then
    bad "no genuine baseline yet — run: elan-fp score"
    return 1
  fi
  need_root
  say "${Y}Use a DIFFERENT finger${N} than the enrolled one for all $ITERATIONS presses."
  say "These scores are what an attacker would achieve."
  say
  collect_scores "$imp" || return 1

  read -r gn gm gsd gmax _ <<<"$(stats_of "$gen")"
  read -r inn im isd imax _ <<<"$(stats_of "$imp")"
  say
  say "  genuine   n=$gn  mean=$gm  sd=$gsd  best=$gmax"
  say "  impostor  n=$inn  mean=$im  sd=$isd  ${R}worst-case=$imax${N}"
  say
  LC_ALL=C awk -v gm="$gm" -v im="$im" -v gsd="$gsd" -v isd="$isd" -v imax="$imax" '
    BEGIN {
      den = sqrt((gsd*gsd + isd*isd) / 2)
      d = den > 0 ? (gm - im) / den : 0
      printf("  separation (d-prime) = %.2f\n\n", d)
      if (d >= 3)      print "  Good separation. A threshold above the impostor max is defensible."
      else if (d >= 2) print "  Usable but tight. Expect retries."
      else if (d >= 1) print "  Weak. Genuine and impostor distributions overlap materially."
      else             print "  NO meaningful separation. This matcher cannot be made safe by tuning."
      printf("\n  Any threshold at or below %.3f accepts a wrong finger.\n", imax)
    }'
  return 0
}

# Measure the actual match score rather than guessing at the threshold.
# elanpress logs: "NCC 0.412 (threshold 0.55)"
do_score() {
  local i result scores=() s threshold="" seen=0 now=0
  mkdir -p "$LOGDIR"

  if [[ $(current_driver) != elanpress ]]; then
    bad "this only applies to the elanpress driver"
    return 1
  fi
  if [[ -z $(enrolled_fingers) ]]; then
    bad "no enrolled prints — run: elan-fp enroll"
    return 3
  fi

  need_root
  say "Measuring match scores over $ITERATIONS attempts."
  say "Press and hold exactly as you did when enrolling."
  say

  : > "$LOGDIR/genuine.txt"
  start_debug_daemon || { bad "could not start fprintd with debug"; return 1; }
  trap 'stop_debug_daemon' EXIT

  for ((i = 1; i <= ITERATIONS; i++)); do
    printf '  %2d/%d ... ' "$i" "$ITERATIONS"
    result=$(run_fprintd "$VERIFY_TIMEOUT" "$LOGDIR/score-$i.log" fprintd-verify "$FPUSER")
    # Accept both '.' and ',' decimal separators (locale-dependent glib output).
    # Only accept a score if the driver emitted a NEW line this attempt;
    # otherwise tail -1 silently repeats the previous attempt's value.
    now=$(grep -ac "NCC" "$DBG_LOG" 2>/dev/null || echo 0)
    if (( now > seen )); then
      s=$(grep -a "NCC" "$DBG_LOG" 2>/dev/null | tail -1 \
          | grep -oE "NCC [0-9]+[.,][0-9]+" | awk '{print $2}' | tr ',' '.')
    else
      s=""
    fi
    seen=$now
    if [[ -z $threshold ]]; then
      threshold=$(grep -a "NCC" "$DBG_LOG" 2>/dev/null | tail -1 \
        | grep -oE "threshold [0-9]+[.,][0-9]+" | awk '{print $2}' | tr ',' '.')
    fi
    if [[ -n $s ]]; then
      scores+=("$s")
      printf '%s\n' "$s" >> "$LOGDIR/genuine.txt"
      case $result in
        match) printf '%sNCC %s  match%s\n'    "$G" "$s" "$N" ;;
        *)     printf '%sNCC %s  no-match%s\n' "$Y" "$s" "$N" ;;
      esac
    else
      printf '%s%s (no score logged)%s\n' "$R" "$result" "$N"
    fi
  done

  stop_debug_daemon; trap - EXIT
  say

  if (( ${#scores[@]} == 0 )); then
    bad "no scores captured — the driver never reached the comparison"
    note "log: $DBG_LOG"
    return 1
  fi

  local best worst mean
  best=$(printf '%s\n' "${scores[@]}" | LC_ALL=C sort -g | tail -1)
  worst=$(printf '%s\n' "${scores[@]}" | LC_ALL=C sort -g | head -1)
  mean=$(printf '%s\n' "${scores[@]}" | LC_ALL=C awk '{t+=$1} END {printf "%.3f", t/NR}')
  threshold=${threshold:-0.55}

  say "  scores: ${scores[*]}"
  # Drift vs scatter: a declining trend points at the sensor or the finger
  # degrading across the run; scatter points at placement variance. These are
  # indistinguishable from pass/fail counts alone.
  printf '%s\n' "${scores[@]}" | LC_ALL=C awk '
    {v[NR]=$1}
    END {
      if (NR < 6) exit
      h = int(NR/2)
      for (i=1;i<=h;i++)      a+=v[i]
      for (i=NR-h+1;i<=NR;i++) b+=v[i]
      a/=h; b/=h; d=a-b
      printf "  first half %.3f  ->  second half %.3f   (drift %+.3f)\n", a, b, d
      if (d > 0.06)       print "  ! declining across the run — sensor or finger degrading, not placement."
      else if (d < -0.06) print "  ! improving across the run — likely technique settling in."
      else                print "  no drift — variance is placement/presentation, not degradation."
    }'

  say "  best $best   mean $mean   worst $worst   threshold $threshold"
  say
  # If impostor scores exist, they override any advice based on genuine scores
  # alone: a high genuine score means nothing if impostors reach it too.
  if [[ -s $LOGDIR/impostor.txt ]]; then
    local imax
    imax=$(LC_ALL=C sort -g "$LOGDIR/impostor.txt" | tail -1)
    local below
    below=$(LC_ALL=C awk -v x="$imax" '$1 <= x {c++} END {print c+0}' "$LOGDIR/genuine.txt")
    warn "impostor scores on record: max ${imax}"
    warn "${below}/${#scores[@]} genuine presses scored at or below that."
    note "Any threshold accepting them also accepts a wrong finger."
    note "Do NOT lower the threshold on the strength of the numbers above."
    return 0
  fi

  LC_ALL=C awk -v b="$best" -v m="$mean" -v t="$threshold" '
    BEGIN {
      if (b >= t)        print "  Some attempts already clear the threshold — presentation consistency is the issue.";
      else if (m >= t*0.8) print "  Close. Genuine scores sit just under the threshold; lowering it is defensible.";
      else if (m >= t*0.5) print "  Well short. Lowering the threshold this far would weaken security materially.";
      else                 print "  Very low. This looks like the images are not comparable, not a threshold problem.";
    }'
  note "Compare against an impostor score before lowering anything:"
  note "  enroll a DIFFERENT finger, then verify with the original one."
  note "  A threshold is only safe if it sits above the impostor distribution."
  return 0
}

do_verify() {
  local attempt=0 result outfile
  mkdir -p "$LOGDIR"

  while (( attempt < 4 )); do
    attempt=$((attempt + 1))
    outfile="$LOGDIR/verify-$attempt.log"

    step "Verify attempt $attempt/4 — touch the sensor when prompted"
    result=$(run_fprintd "$VERIFY_TIMEOUT" "$outfile" fprintd-verify "$FPUSER")

    case $result in
      match)
        ok "MATCH — the sensor is working"
        return 0 ;;
      no-match)
        warn "no match (a real comparison ran, the score was too low)"
        note "this is a matcher/threshold problem, not a wedged device"
        return 2 ;;
      no-prints)
        bad "no enrolled prints for '$FPUSER' — run: elan-fp enroll"
        return 3 ;;
      hang)
        warn "timed out after ${VERIFY_TIMEOUT}s with no result — device is wedged"
        ;;
      error)
        warn "failed: $(grep -oiE 'error[^,]*|proto[^,]*' "$outfile" | head -1)"
        ;;
    esac

    if (( DEBUG )) && [[ $result != match ]]; then
      note "--- $outfile ---"
      sed 's/^/      /' "$outfile" | tail -20
    fi

    case $result in
      match|no-match|no-prints) : ;;
    esac

    if (( attempt < 4 )); then
      say
      unwedge "$attempt" || break
      say
    fi
  done

  bad "still failing after $attempt attempts and the full recovery ladder"
  say
  warn "This sensor is known to survive only ONE activation per power-up on"
  warn "some units, and no software-reachable reset clears that state."
  note "Next, in increasing cost:"
  note "  systemctl suspend     # S3 may drop VBUS to internal ports"
  note "  full poweroff         # not a reboot — power must actually drop"
  note "Logs: $LOGDIR"
  return 1
}

do_enroll() {
  mkdir -p "$LOGDIR"
  # Unwedge FIRST: on affected units the one good activation per power-up is a
  # scarce resource, and spending it on a doomed attempt wastes the boot.
  step "Preparing the device before enrolling"
  unwedge 2
  if wait_device_stable; then
    ok "device settled at $(basename "$(find_device)"), no stale fprintd handle"
  else
    warn "device address kept changing; enrolment may fail immediately"
  fi
  say

  local outfile="$LOGDIR/enroll.log"
  step "Enrolling"
  say "  PRESS AND HOLD STILL. Land the finger, keep it completely still for a"
  say "  second, then lift straight up. Do NOT slide."
  say "  The driver now SELECTS the sharpest frame rather than averaging, so a"
  say "  still finger gives it several shots at the same patch of skin. Sliding"
  say "  makes each capture a different part of the finger, which is what made"
  say "  earlier attempts fail to match."
  say "  Between presses, shift slightly so the set covers the fingertip."
  say
  local result
  result=$(run_fprintd "$ENROLL_TIMEOUT" "$outfile" fprintd-enroll "$FPUSER")

  case $result in
    match) ok "enrollment completed"; say; note "now run: elan-fp test"; return 0 ;;
    hang)  bad "enrollment hung — device wedged"; return 1 ;;
    *)     bad "enrollment failed"; sed -n '1,20p' "$outfile"; return 1 ;;
  esac
}

swipe_prompt() {
  say "  ${BOLD}SWIPE — do not press and hold.${N}"
  say "  Put the pad of your finger at the TIP end of the sensor and draw it"
  say "  steadily toward you, across the short axis of the strip, over about"
  say "  one second. The sensor window is 2.6 mm in that direction, so the"
  say "  motion is the length of your fingertip, not the width of the sensor."
  say
  note "The device stops sending after ~0.5 s whatever you do (a known"
  note "firmware wedge), so each swipe is truncated on purpose and the driver"
  note "mosaics several of them into one map. A short swipe is expected."
}


# Wait until the device has been enumerated at a STABLE address, then make sure
# no fprintd is holding a handle to whatever it was before.
#
# Re-enumeration (recovery level 3, and the kernel's own recovery) gives the
# device a new address. A fprintd that opened the device across that boundary
# keeps a handle to a node that no longer exists, and the very next operation
# fails with "This device has been removed from the system" -- which looks like
# a crash on the first swipe but happened before the user touched anything.
wait_device_stable() {
  local tries=0 a b
  while (( tries < 10 )); do
    a=$(find_device) || { sleep 1; tries=$((tries+1)); continue; }
    sleep 1
    b=$(find_device) || { sleep 1; tries=$((tries+1)); continue; }
    if [[ $a == "$b" ]]; then
      # settled at $a; drop any daemon that predates it
      kill_fprintd
      sleep 1
      return 0
    fi
    tries=$((tries+1))
  done
  return 1
}

do_swipe_enroll() {
  mkdir -p "$LOGDIR"
  # Unwedge FIRST: on affected units the one good activation per power-up is a
  # scarce resource, and spending it on a doomed attempt wastes the boot.
  step "Preparing the device before enrolling"
  unwedge 2
  if wait_device_stable; then
    ok "device settled at $(basename "$(find_device)")"
  else
    warn "device address kept changing; enrolment may fail immediately"
  fi


  local outfile="$LOGDIR/swipe-enroll.log"
  step "Enrolling by swiping"
  swipe_prompt
  say "  You will be asked to swipe several times. Shift the finger slightly"
  say "  sideways between swipes: a swipe already covers the full LENGTH of the"
  say "  fingertip, so only sideways movement adds new area to the map."
  say
  note "Swipes that cannot be registered against the others are rejected and"
  note "re-prompted. About one in three is normal; the driver gives up after 12."
  say

  # Stream the driver's verdicts LIVE and annotate each one. Buffering these
  # into a file and printing at the end means swiping blind: you cannot tell a
  # rejected swipe from an accepted one until the whole enrolment is over, so
  # you cannot correct your technique while it still matters.
  # Start the daemon BY HAND, once, and use THAT daemon for everything.
  #
  # Every claim/release cycle costs this device: a readiness probe against a
  # D-Bus-activated daemon, followed by killing it to start our own, was enough
  # to make the device vanish before the first swipe. One daemon, one open.
  #
  # Running it by hand also keeps the driver's explanation of a refusal out of
  # the system journal and its dumps out of fprintd.service's PrivateTmp --
  # both of which are invisible exactly when something has gone wrong.
  local dumpdir="$LOGDIR/enroll-dump"
  rm -rf "$dumpdir"; mkdir -p "$dumpdir"
  DBG_LOG="$LOGDIR/driver-enroll-$(date +%Y%m%d-%H%M%S).log"
  kill_fprintd
  as_root sh -c "LC_ALL=C G_MESSAGES_DEBUG=all ELANPRESS_DUMP_DIR='$dumpdir' /usr/lib/fprintd -t > '$DBG_LOG' 2>&1 &"
  sleep 2
  trap 'stop_debug_daemon' EXIT

  step "Checking the device answers (via this daemon, no extra open/close)"
  if timeout 20 fprintd-list "$FPUSER" >/dev/null 2>&1 || \
     timeout 20 fprintd-list "$FPUSER" 2>&1 | grep -q "NoEnrolledPrints"; then
    ok "device is answering — ready to enrol"
  else
    bad "device will not answer"
    note "it is wedged harder than a suspend/resume can clear"
    note "power the machine off, wait 10 s, boot, and run this again"
    stop_debug_daemon; trap - EXIT
    return 1
  fi
  say

  say "  ${BOLD}SWIPE NOW${N} — then keep swiping as prompted."
  say
  local rc=0
  timeout "$SWIPE_ENROLL_TIMEOUT" stdbuf -oL -eL fprintd-enroll "$FPUSER" 2>&1 \
    | tee "$outfile" \
    | { n=0; acc=0
        while IFS= read -r line; do
          case $line in
            *enroll-stage-passed*)
              n=$((n+1)); acc=$((acc+1))
              printf '  %s✔%s swipe %d ACCEPTED  (%d on the map)  — swipe again\n' \
                     "$G" "$N" "$n" "$acc" ;;
            *enroll-swipe-too-short*)
              n=$((n+1))
              printf '  %s✘%s swipe %d too short — draw the finger further, ~1 s\n' \
                     "$Y" "$N" "$n" ;;
            *enroll-finger-not-centered*)
              n=$((n+1))
              printf '  %s✘%s swipe %d off-centre — start at the tip end of the strip\n' \
                     "$Y" "$N" "$n" ;;
            *enroll-retry-scan*|*enroll-remove-and-retry*)
              n=$((n+1))
              printf '  %s✘%s swipe %d not usable — lift fully, then swipe again\n' \
                     "$Y" "$N" "$n" ;;
            *enroll-duplicate*)
              n=$((n+1))
              printf '  %s!%s swipe %d duplicates one already on the map — shift sideways\n' \
                     "$Y" "$N" "$n" ;;
            *enroll-completed*)
              printf '  %s✔%s enrolment COMPLETE — %d swipes on the map\n' "$G" "$N" "$acc" ;;
            *enroll-disconnected*)
              printf '  %s✘%s device dropped off the bus mid-enrolment\n' "$R" "$N" ;;
            *enroll-unknown-error*)
              printf '  %s✘%s driver error — see %s\n' "$R" "$N" "$outfile" ;;
            *Enrolling*|*Using\ device*) : ;;
            *) [[ -n $line ]] && printf '    %s%s%s\n' "$DIM" "$line" "$N" ;;
          esac
        done; }
  rc=${PIPESTATUS[0]}
  say

  local result
  if (( rc == 124 )); then result=hang
  elif grep -q "enroll-completed" "$outfile" 2>/dev/null; then result=match
  else result=error; fi

  case $result in
    match) ok "enrollment completed"
           # The map geometry is the one number that says whether the enrolment
           # is any good, and it only appears in the driver log.
           grep -o 'enrolled .*' "$outfile" 2>/dev/null | tail -1 | while read -r l; do
             note "$l"
           done
           say; note "now run: elan-fp swipe-test"; return 0 ;;
    hang)  bad "enrollment hung — device wedged"
           note "run: elan-fp unwedge, then try again"; return 1 ;;
    *)     bad "enrollment failed"
           sed -n '1,25p' "$outfile"
           # the driver's own reason lives in the daemon log, not the client's
           local why
           why=$(grep -ahE "no usable map|salvaging|refus|reject" "$DBG_LOG" 2>/dev/null | tail -3)
           if [[ -n $why ]]; then
             say; warn "driver said:"
             printf '%s\n' "$why" | sed 's/^/      /'
           fi
           note "driver log: $DBG_LOG"
           note "dumps:      $dumpdir"
           note "if every swipe was rejected, the swipes were of different parts"
           note "of the finger — swipe the same way each time, shifting only a little"
           return 1 ;;
  esac
}

do_swipe_test() {
  local pass=0 fail=0 hang=0 i result outfile
  mkdir -p "$LOGDIR"

  if [[ -z $(enrolled_fingers) ]]; then
    bad "no enrolled prints — run: elan-fp swipe-enroll"
    return 3
  fi

  say "Running $ITERATIONS verifications."
  swipe_prompt
  say "This is the only meaningful gate: enrollment succeeding proves nothing."
  say
  say "  ${BOLD}SWIPE at each prompt.${N}"
  say
  for ((i = 1; i <= ITERATIONS; i++)); do
    outfile="$LOGDIR/swipe-test-$i.log"
    printf '  %2d/%d ... ' "$i" "$ITERATIONS"
    result=$(run_fprintd "$SWIPE_VERIFY_TIMEOUT" "$outfile" fprintd-verify "$FPUSER")
    case $result in
      match)    printf '%smatch%s\n'    "$G" "$N"; pass=$((pass + 1)) ;;
      no-match) printf '%sno-match%s\n' "$Y" "$N"; fail=$((fail + 1)) ;;
      hang)     printf '%shang%s\n'     "$R" "$N"; hang=$((hang + 1)) ;;
      *)        printf '%serror%s\n'    "$R" "$N"; fail=$((fail + 1)) ;;
    esac

    # A wedge mid-run destroys the sample rather than the device. Recover and
    # RETRY the same attempt, so a run always yields $ITERATIONS real verdicts.
    if [[ $result == hang || $result == error ]]; then
      printf '        recovering ... '
      if usb_suspend_cycle >/dev/null 2>&1; then printf 'ok, retrying\n'
      else kill_fprintd; printf 'partial, retrying\n'; fi
      result=$(run_fprintd "$SWIPE_VERIFY_TIMEOUT" "$outfile" fprintd-verify "$FPUSER")
      case $result in
        match)    printf '  %2d/%d retry ... %smatch%s\n'    "$i" "$ITERATIONS" "$G" "$N"
                  pass=$((pass + 1)); hang=$((hang > 0 ? hang - 1 : 0)) ;;
        no-match) printf '  %2d/%d retry ... %sno-match%s\n' "$i" "$ITERATIONS" "$Y" "$N"
                  fail=$((fail + 1)); hang=$((hang > 0 ? hang - 1 : 0)) ;;
        *)        printf '  %2d/%d retry ... %sstill wedged%s\n' "$i" "$ITERATIONS" "$R" "$N" ;;
      esac
    fi
    (( hang >= 4 )) && { say; warn "wedging repeatedly even after recovery — stopping"; break; }
  done

  say
  say "  ${G}match${N} $pass   ${Y}no-match${N} $fail   ${R}hang${N} $hang   of $ITERATIONS"
  say
  if (( pass == ITERATIONS )); then
    ok "$pass/$ITERATIONS genuine swipes accepted."
    warn "This measures FALSE REJECTS only. Nothing here measures false ACCEPTS:"
    warn "the driver has never been tested against a second finger or person,"
    warn "so it has no false-accept rate and must not be wired to PAM."
  elif (( pass > 0 )); then
    warn "intermittent — every failed auth costs a delay and a re-swipe."
    note "check the swipe direction is the same each time"
  else
    bad "no matches"
    note "run: elan-fp swipe-enroll  (a press-era template cannot be matched"
    note "by the swipe driver and is refused; the log will say so)"
  fi
  return 0
}

do_test() {
  local pass=0 fail=0 hang=0 i result outfile
  mkdir -p "$LOGDIR"

  if [[ -z $(enrolled_fingers) ]]; then
    bad "no enrolled prints — run: elan-fp enroll"
    return 3
  fi

  say "Running $ITERATIONS verifications."
  say "PRESS AND HOLD STILL at each prompt — same as enrolment, no sliding."
  say "This is the only meaningful gate: enrollment succeeding proves nothing."
  say
  for ((i = 1; i <= ITERATIONS; i++)); do
    outfile="$LOGDIR/test-$i.log"
    printf '  %2d/%d ... ' "$i" "$ITERATIONS"
    result=$(run_fprintd "$VERIFY_TIMEOUT" "$outfile" fprintd-verify "$FPUSER")
    case $result in
      match)    printf '%smatch%s\n'    "$G" "$N"; pass=$((pass + 1)) ;;
      no-match) printf '%sno-match%s\n' "$Y" "$N"; fail=$((fail + 1)) ;;
      hang)     printf '%shang%s\n'     "$R" "$N"; hang=$((hang + 1)) ;;
      *)        printf '%serror%s\n'    "$R" "$N"; fail=$((fail + 1)) ;;
    esac

    # A wedge mid-run destroys the sample rather than the device. Recover and
    # RETRY the same attempt, so a run always yields $ITERATIONS real verdicts;
    # stopping early was costing more information than it saved.
    if [[ $result == hang || $result == error ]]; then
      printf '        recovering ... '
      if usb_suspend_cycle >/dev/null 2>&1; then printf 'ok, retrying\n'
      else kill_fprintd; printf 'partial, retrying\n'; fi
      result=$(run_fprintd "$VERIFY_TIMEOUT" "$outfile" fprintd-verify "$FPUSER")
      case $result in
        match)    printf '  %2d/%d retry ... %smatch%s\n'    "$i" "$ITERATIONS" "$G" "$N"
                  pass=$((pass + 1)); hang=$((hang > 0 ? hang - 1 : 0)) ;;
        no-match) printf '  %2d/%d retry ... %sno-match%s\n' "$i" "$ITERATIONS" "$Y" "$N"
                  fail=$((fail + 1)); hang=$((hang > 0 ? hang - 1 : 0)) ;;
        *)        printf '  %2d/%d retry ... %sstill wedged%s\n' "$i" "$ITERATIONS" "$R" "$N" ;;
      esac
    fi
    (( hang >= 4 )) && { say; warn "wedging repeatedly even after recovery — stopping"; break; }
  done

  say
  say "  ${G}match${N} $pass   ${Y}no-match${N} $fail   ${R}hang${N} $hang   of $ITERATIONS"
  say
  if (( pass == ITERATIONS )); then
    ok "$pass/$ITERATIONS — this is the bar for wiring PAM."
    note "On KDE, /usr/lib/pam.d/kde-fingerprint already loads pam_fprintd,"
    note "so the lock screen should work with no PAM edits at all."
    note "Do NOT edit /etc/pam.d/system-auth or /etc/pam.d/sudo."
  elif (( pass > 0 )); then
    warn "intermittent — not safe for PAM. Every failed auth costs a delay."
  else
    bad "no matches"
  fi
  return 0
}

do_status() {
  local dev driver fingers
  if dev=$(find_device); then
    ok "sensor present: $VID:$PID at ${dev##*/}"
    note "runtime_status = $(cat "$dev/power/runtime_status" 2>/dev/null)"
    note "power/control  = $(cat "$dev/power/control" 2>/dev/null)"
    local delay; delay=$(cat "$dev/power/autosuspend_delay_ms" 2>/dev/null)
    if [[ $delay == -* ]]; then
      note "autosuspend    = disabled ($delay) — blocks level-2 recovery"
    else
      note "autosuspend    = ${delay}ms"
    fi
  else
    bad "sensor $VID:$PID not found on the USB bus"
    return 1
  fi

  driver=$(current_driver)
  case $driver in
    elanpress) ok "driver: elanpress (cross-correlation matching)" ;;
    elan)      warn "driver: elan (NBIS minutiae — known not to verify on this sensor)" ;;
    *)         warn "driver: could not determine" ;;
  esac

  if pgrep -x fprintd >/dev/null; then
    note "fprintd is running (pid $(pgrep -x fprintd | tr '\n' ' '))"
  fi

  fingers=$(enrolled_fingers)
  if [[ -n $fingers ]]; then
    ok "enrolled: $(printf '%s' "$fingers" | tr '\n' ' ')"
  else
    warn "no enrolled prints for '$FPUSER'"
  fi

  if grep -rqs fprintd /etc/pam.d/; then
    warn "pam_fprintd is referenced in /etc/pam.d — verify it before trusting sudo"
    grep -rns fprintd /etc/pam.d/ | sed 's/^/      /'
  else
    note "no pam_fprintd in /etc/pam.d (KDE's vendor file is separate and safe)"
  fi
}


# Collect a labelled dataset for offline matcher development. Requires a driver
# built with ELANPRESS_DUMP_DIR support. Any enrolled print will do -- we only
# want the captures, not the verdicts.
DATASET="${XDG_DATA_HOME:-$HOME/.local/share}/elan-fp/dataset"
do_collect() {
  local label="${1:-}"
  if [[ -z $label ]]; then
    bad "usage: elan-fp collect <label>   (e.g. 'right-index', 'left-thumb')"
    return 1
  fi
  if [[ -z $(enrolled_fingers) ]]; then
    bad "verify is used to trigger captures, so something must be enrolled first"
    note "run: elan-fp enroll"
    return 3
  fi

  need_root
  local out="$DATASET/$label" raw
  raw=$(mktemp -d)
  mkdir -p "$out"

  say "Collecting $ITERATIONS captures labelled '${B}${label}${N}'."
  say "Press the SAME finger each time, but vary placement slightly —"
  say "a dataset of identical presses will overstate how good any matcher is."
  say

  kill_fprintd
  as_root sh -c "LC_ALL=C G_MESSAGES_DEBUG=all ELANPRESS_DUMP_DIR='$raw' /usr/lib/fprintd -t > '$LOGDIR/collect.log' 2>&1 &"
  sleep 2
  trap 'stop_debug_daemon' EXIT

  local i
  for ((i = 1; i <= ITERATIONS; i++)); do
    printf '  %2d/%d ... ' "$i" "$ITERATIONS"
    run_fprintd "$VERIFY_TIMEOUT" "$LOGDIR/collect-$i.log" fprintd-verify "$FPUSER" >/dev/null
    printf 'captured\n'
  done

  as_root pkill -x fprintd 2>/dev/null
  trap - EXIT
  sleep 1

  as_root chown -R "$(id -u):$(id -g)" "$raw" 2>/dev/null
  local n=0
  local f
  for f in "$raw"/press_*.pgm; do
    [[ -e $f ]] || continue
    mv "$f" "$out/$(date +%s)-$(basename "$f")"
    n=$((n + 1))
  done
  rm -rf "$raw"

  say
  if (( n == 0 )); then
    bad "no captures written — is the driver built with ELANPRESS_DUMP_DIR support?"
    note "check: strings -a /usr/lib/libfprint-2.so.2.0.0 | grep ELANPRESS_DUMP_DIR"
    return 1
  fi
  ok "$n captures saved to $out"
  say
  say "  dataset so far:"
  local d
  for d in "$DATASET"/*/; do
    [[ -d $d ]] || continue
    printf '    %-20s %d captures\n' "$(basename "$d")" "$(find "$d" -name '*.pgm' | wc -l)"
  done
  say
  note "Collect at least two labels (two different fingers) so impostor pairs exist."
  return 0
}

# ----------------------------------------------------------------- swipe ----
#
# The 0c6e is a 150x52 strip: 7.5 x 2.6 mm at 508 dpi. 2.6 mm is far too short
# to press a fingertip against, so the only geometry that can cover a finger is
# a swipe, and no swipe capture from this sensor has ever been published. This
# subcommand is the one-command test of that: it drives ONE capture through the
# stock upstream "elan" swipe driver with the dump env vars set, then reports
# what came back -- frame count, measured frame rate, the inter-frame
# displacements the assembler estimated, the assembled dimensions, and the
# analyze-swipe.py verdict.
#
# fprintd.service sets PrivateTmp=yes and ProtectHome=yes, so a daemon started
# by D-Bus cannot write a dump anywhere we can read it. The daemon is therefore
# started by hand, exactly as `score` and `collect` do.
FPHOME=$(getent passwd "$FPUSER" 2>/dev/null | cut -d: -f6)
FPHOME=${FPHOME:-$HOME}
SWIPEDIR="${XDG_DATA_HOME:-$FPHOME/.local/share}/elan-fp/swipe"
ANALYZE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/analyze-swipe.py"

# The swipe driver is a different package from the press one and reports a
# different name, so refuse early rather than dumping nothing and blaming the
# sensor.
swipe_driver_ok() {
  local so=/usr/lib/libfprint-2.so.2
  if [[ ! -r $so ]]; then
    bad "no /usr/lib/libfprint-2.so.2"
    return 1
  fi
  # Inspected with strings, not with fprintd-list: asking the daemon which
  # driver is loaded makes it open the device, and this sensor only gives us
  # about one working session per power-up. Do not spend it on a version check.
  if so_has FpiDeviceElanPress; then
    bad "the elanpress driver is installed; it averages frames into one"
    bad "150x52 image instead of assembling them, so there is no swipe to see"
    return 1
  fi
  if ! so_has FP_ELAN_DUMP_DIR; then
    bad "the installed libfprint has no FP_ELAN_DUMP_DIR support"
    note "this needs the swipe package, which is NOT installed by default:"
    note "  cd /home/melb/projects/libfprint-elanswipe-pkg && makepkg -sf"
    note "  sudo pacman -U libfprint-elanswipe-1.94.100.elanswipe-1-x86_64.pkg.tar.zst"
    note "it REPLACES the system libfprint (conflicts with libfprint-elanpress)"
    return 1
  fi
  return 0
}

# Enrolled prints, read off fprintd's storage rather than out of the daemon,
# for the same reason: no device I/O. fprintd keys the store by driver id, so
# prints enrolled under elanpress do not appear here.
swipe_has_enrolled() {
  as_root find "/var/lib/fprint/$FPUSER/elan" -type f 2>/dev/null | grep -q .
}

# Start fprintd by hand with the dump environment. $1 = dump dir.
start_swipe_daemon() {
  local dump="$1" env_str
  mkdir -p "$LOGDIR" "$dump"
  DBG_LOG="$LOGDIR/swipe-$(date +%Y%m%d-%H%M%S).log"

  env_str="LC_ALL=C G_MESSAGES_DEBUG=all FP_ELAN_DUMP_DIR='$dump'"
  # Default is to skip calibration on this PID: on fw 0x0161 it reports
  # success and capture then fails anyway. --calibrate re-tests that.
  if (( SWIPE_CALIBRATE )); then
    env_str="$env_str FP_ELAN_SKIP_CALIBRATION=0"
  else
    env_str="$env_str FP_ELAN_SKIP_CALIBRATION=1"
  fi
  [[ -n $SWIPE_MAX_FRAMES ]] && env_str="$env_str FP_ELAN_MAX_FRAMES=$SWIPE_MAX_FRAMES"
  (( SWIPE_PARTIAL )) || env_str="$env_str FP_ELAN_PARTIAL=0"

  kill_fprintd
  as_root sh -c "$env_str /usr/lib/fprintd -t > '$DBG_LOG' 2>&1 &"
  sleep 2
  if ! pgrep -x fprintd >/dev/null; then
    bad "fprintd did not stay up — see $DBG_LOG"
    return 1
  fi
  return 0
}

# Newest capture-* directory under $1 that has a finished capture.txt.
swipe_latest_capture() {
  local d last=""
  for d in "$1"/capture-*/; do
    [[ -d $d ]] || continue
    last="${d%/}"
  done
  [[ -n $last ]] && printf '%s' "$last"
}

swipe_field() { sed -n "s/^$2 //p" "$1/capture.txt" 2>/dev/null | tail -1; }

# One attempt. $1 = dump dir. Echoes nothing; return 0 if a capture directory
# with at least one raw frame appeared.
swipe_attempt() {
  local dump="$1" op waited=0 cap=""
  if swipe_has_enrolled; then
    op=(fprintd-verify "$FPUSER")
    note "a print is enrolled, using verify (one capture)"
  else
    op=(fprintd-enroll -f right-index "$FPUSER")
    note "nothing enrolled for this driver, using enroll (it will ask for"
    note "several swipes; one is enough, the tool stops as soon as it has one)"
  fi

  start_swipe_daemon "$dump" || return 1
  trap 'stop_debug_daemon' EXIT

  say
  say "${Y}Swipe now.${N}  Put the pad of your finger on the power button and"
  say "draw it along the button in one steady motion, about 1 second end to"
  say "end, keeping contact the whole way. The strip is 2.6 mm across, so the"
  say "motion is across the short axis."
  say

  timeout "$SWIPE_TIMEOUT" "${op[@]}" > "$LOGDIR/swipe-client.log" 2>&1 &
  local client=$!

  # Poll for a finished capture rather than waiting out the whole timeout:
  # enroll would otherwise keep asking for four more swipes.
  while (( waited < SWIPE_TIMEOUT )); do
    sleep 1; waited=$((waited + 1))
    cap=$(swipe_latest_capture "$dump")
    if [[ -n $cap ]] && grep -qE '^(assembled_height|result) ' "$cap/capture.txt" 2>/dev/null; then
      sleep 1   # let the last writes land
      break
    fi
    kill -0 "$client" 2>/dev/null || break
  done

  # Kill the timeout wrapper AND the client it spawned: killing only the
  # wrapper leaves fprintd-enroll holding the device open, and the next
  # attempt then fails for a reason that has nothing to do with the sensor.
  kill "$client" 2>/dev/null
  pkill -x fprintd-enroll 2>/dev/null
  pkill -x fprintd-verify 2>/dev/null
  wait "$client" 2>/dev/null
  stop_debug_daemon; trap - EXIT
  as_root chown -R "$(id -u "$FPUSER"):$(id -g "$FPUSER")" "$dump" 2>/dev/null

  cap=$(swipe_latest_capture "$dump")
  [[ -n $cap ]] || return 1
  (( $(find "$cap" -name 'raw_*.pgm' | wc -l) > 0 )) || return 1
  return 0
}

# Everything the capture can tell us, separated into what was measured and
# what it means. No claim is made about accuracy: there is no swipe data to
# base one on and one capture could not support one anyway.
swipe_report() {
  local cap="$1" n_raw frames assembled_w assembled_h mean_dy mean_dx
  local lim_dy lim_dx dropped elapsed fps verdict result

  n_raw=$(find "$cap" -name 'raw_*.pgm' | wc -l)
  frames=$(swipe_field "$cap" frames_captured)
  dropped=$(swipe_field "$cap" frames_dropped)
  assembled_w=$(swipe_field "$cap" assembled_width)
  assembled_h=$(swipe_field "$cap" assembled_height)
  mean_dy=$(swipe_field "$cap" mean_delta_y)
  mean_dx=$(swipe_field "$cap" mean_abs_delta_x)
  lim_dy=$(swipe_field "$cap" delta_y_at_limit)
  lim_dx=$(swipe_field "$cap" delta_x_at_limit)
  elapsed=$(swipe_field "$cap" elapsed_ms)
  result=$(swipe_field "$cap" result)

  # Measured frame rate, from the per-frame timestamps. This was previously
  # only inferred from USB full-speed bulk arithmetic (~16-20 ms/frame).
  fps=$(LC_ALL=C awk 'NR==1{f=$2} {l=$2; n++} END{
          if (n > 1 && l > f) printf "%.1f fps (%.1f ms/frame)", (n-1)/((l-f)/1000), (l-f)/(n-1);
          else printf "n/a"}' "$cap/timings.txt" 2>/dev/null)

  say
  say "  ${B}capture${N}          $cap"
  printf '  %-16s %s raw frames written, %s kept, %s dropped as dark\n' \
    "frames" "$n_raw" "${frames:-?}" "${dropped:-0}"
  printf '  %-16s %s\n' "frame rate" "${fps:-n/a}"

  if [[ -z $assembled_h ]]; then
    say
    bad "no image was assembled (${result:-capture did not complete})"
    note "raw frames are still in $cap — the sensor's side of this is intact"
    note "and can be re-examined offline with analyze-pgm.py"
    return 1
  fi

  printf '  %-16s mean delta_y %s px, mean |delta_x| %s px\n' \
    "displacement" "${mean_dy:-?}" "${mean_dx:-?}"
  printf '  %-16s delta_y %s, |delta_x| %s  (of %s pairs)\n' \
    "at search limit" "${lim_dy:-?}" "${lim_dx:-?}" "$(( ${frames:-1} - 1 ))"
  printf '  %-16s %s x %s px = %s\n' "assembled" "$assembled_w" "$assembled_h" \
    "$(LC_ALL=C awk -v w="$assembled_w" -v h="$assembled_h" \
        'BEGIN{printf "%.1f x %.1f mm at 508 dpi", w/20.0, h/20.0}')"
  printf '  %-16s %s ms\n' "elapsed" "${elapsed:-?}"

  # A press capture is one 150x52 frame = 15.6 mm2. Anything that did not grow
  # substantially past that did not assemble, whatever the verdict says.
  local press_h=52
  if (( assembled_h <= press_h * 2 )); then
    say
    bad "the assembly is no taller than two frames — the frames did not"
    bad "register against each other"
  fi

  if [[ ${lim_dy:-0} -gt 0 && ${frames:-0} -gt 2 ]] &&
     (( lim_dy * 2 >= frames - 1 )); then
    say
    warn "over half the frames hit find_overlap's delta_y search limit:"
    warn "the estimator fell off the end of its window rather than finding a"
    warn "registration. A faster swipe cannot be tracked past 49 px/frame."
  fi

  if [[ ! -r $ANALYZE ]]; then
    warn "analyze-swipe.py not found at $ANALYZE, skipping the verdict"
    return 0
  fi

  say
  step "analyze-swipe.py"
  verdict=$(timeout 300 python3 "$ANALYZE" "$cap/assembled.pgm" \
              --seams "$cap/deltas.txt" --json 2>"$LOGDIR/analyze.err" \
            | python3 -c 'import json,sys
try:
    d = json.load(sys.stdin)
    print(d[0]["verdict"])
except Exception as e:
    print("analysis failed: %s" % e)' 2>/dev/null)

  if [[ -z $verdict ]]; then
    warn "analyze-swipe.py produced nothing — see $LOGDIR/analyze.err"
    return 0
  fi
  local vrc=2
  case ${verdict^^} in
    USABLE*)      ok "$verdict"; vrc=0 ;;
    NOISE*)       bad "$verdict" ;;
    *)            warn "$verdict" ;;
  esac
  say
  note "full report:  python3 $ANALYZE $cap/assembled.pgm --seams $cap/deltas.txt"
  note "controls:     python3 $ANALYZE --selftest     (ground truth by construction)"
  note "press ref:    python3 $ANALYZE --baseline     (45 real press captures)"
  return $vrc
}

do_swipe() {
  swipe_driver_ok || return 3
  need_root

  local out attempt cap rc=1
  out="$SWIPEDIR/$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$out"

  say "Capturing ONE swipe through the stock upstream elan driver."
  say "calibration: $( (( SWIPE_CALIBRATE )) && echo "ON (--calibrate)" || echo "skipped (default for this PID)")"
  say "frame cap:   ${SWIPE_MAX_FRAMES:-100 (driver default for 0c6e)}"
  say "dumping to:  $out"

  # Same ladder as everywhere else: this sensor answers a persistent 0xaf
  # after about one session per power-up, and only a suspend/resume clears it.
  # Spend the recovery before the attempt, not after a wasted swipe.
  for attempt in 1 2 3; do
    say
    step "Attempt $attempt/3"
    case $attempt in
      1) unwedge 1 ;;
      2) unwedge 2 ;;
      3) unwedge 3 ;;
    esac

    if swipe_attempt "$out"; then
      # A capture happened. Whatever the verdict says, do not spend another
      # session re-swiping: the ladder is for "nothing came back at all".
      cap=$(swipe_latest_capture "$out")
      swipe_report "$cap"; rc=$?
      break
    fi

    bad "no frames came back from that attempt"
    if (( attempt < 3 )); then
      note "escalating the recovery ladder and retrying"
    else
      note "driver log: $DBG_LOG"
      note "grep it for 'sensor busy', 'swipe too short', 'delta_x' and"
      note "'assembled image' — those four say which stage failed"
    fi
  done

  say
  note "everything from this run is under $out"
  return $rc
}

do_doctor() {
  mkdir -p "$LOGDIR"
  local out
  out="$LOGDIR/doctor-$(date +%Y%m%d-%H%M%S).txt"
  {
    echo "=== elan-fp doctor ==="
    date
    echo; echo "--- machine ---"
    cat /sys/devices/virtual/dmi/id/sys_vendor /sys/devices/virtual/dmi/id/product_name 2>/dev/null
    uname -r
    echo; echo "--- libfprint ---"
    pacman -Q libfprint libfprint-elanpress libfprint-elan0c6e fprintd 2>/dev/null
    pacman -Qo /usr/lib/libfprint-2.so.2 2>/dev/null
    echo "driver: $(current_driver)"
    echo; echo "--- usb ---"
    lsusb -d "$VID:$PID" 2>/dev/null
    lsusb -v -d "$VID:$PID" 2>/dev/null | grep -E "bcdDevice|bNumEndpoints|bEndpointAddress|MaxPower"
    echo; echo "--- power ---"
    local dev; dev=$(find_device) && for f in control autosuspend_delay_ms runtime_status persist; do
      echo "$f = $(cat "$dev/power/$f" 2>/dev/null)"
    done
    echo; echo "--- enrollment ---"
    timeout 15 fprintd-list "$FPUSER" 2>&1
    echo; echo "--- pam ---"
    grep -rns fprintd /etc/pam.d/ 2>/dev/null || echo "(none in /etc/pam.d)"
    for f in /usr/lib/pam.d/*fingerprint*; do [[ -e $f ]] && echo "${f##*/}"; done
    echo; echo "--- udev ---"
    cat /etc/udev/rules.d/*elan* /etc/udev/rules.d/*fingerprint* 2>/dev/null
  } | tee "$out"
  say
  ok "written to $out"
  note "Safe to attach to a bug report — contains no biometric data."
}

# ------------------------------------------------------------------ main ----

usage() {
  # Print the header block, whatever its length, rather than a fixed range:
  # a fixed range silently truncates the moment a subcommand is added.
  sed -n '3,/^[^#]/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

CMD=""; LABEL=""
while (( $# )); do
  case $1 in
    status|verify|enroll|test|score|impostor|unwedge|swipe|doctor) CMD=$1 ;;
    swipe-enroll|swipe-test) CMD=$1 ;;
    collect) CMD=collect; shift; LABEL="${1:-}" ;;
    swipe-report) CMD=swipe-report; shift; LABEL="${1:-}" ;;
    --debug) DEBUG=1 ;;
    -n) shift; ITERATIONS=${1:-10} ;;
    --calibrate) SWIPE_CALIBRATE=1 ;;
    --no-partial) SWIPE_PARTIAL=0 ;;
    --max-frames) shift; SWIPE_MAX_FRAMES="${1:-}"
                  [[ $SWIPE_MAX_FRAMES =~ ^[0-9]+$ ]] || {
                    bad "--max-frames needs a number"; exit 1; } ;;
    -h|--help) usage 0 ;;
    *) bad "unknown argument: $1"; usage 1 ;;
  esac
  shift
done
[[ -z $CMD ]] && usage 0

if ! command -v fprintd-verify >/dev/null; then
  bad "fprintd is not installed"; exit 1
fi
if ! device_present; then
  bad "no $VID:$PID sensor on this machine"; exit 1
fi

case $CMD in
  status)  do_status ;;
  verify)  need_root; do_verify ;;
  enroll)  need_root; do_enroll ;;
  test)    do_test ;;
  score)   do_score ;;
  impostor) do_impostor ;;
  unwedge) need_root; unwedge 3 ;;
  collect) need_root; do_collect "$LABEL" ;;
  swipe)   do_swipe ;;
  swipe-enroll) need_root; do_swipe_enroll ;;
  swipe-test)   do_swipe_test ;;
  swipe-report)
           if [[ -z $LABEL || ! -d $LABEL ]]; then
             bad "usage: elan-fp swipe-report <capture dir>"
             note "e.g. $SWIPEDIR/<timestamp>/capture-<timestamp>-001"
             exit 1
           fi
           swipe_report "$LABEL" ;;
  doctor)  do_doctor ;;
esac
