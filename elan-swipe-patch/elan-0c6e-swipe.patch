+ * (508 / 25.4 = 20.0 exactly). Nothing in libfprint sets FpImage.ppmm except
+ * secugen, and NBIS derives its quality-map radius from it, so leaving it at
+ * zero silently degrades quality scoring. */
+#define ELAN_0C6E_PPMM 20.0
+
+/* How long to keep retrying a "busy" (0x00/0xaf) pre-scan reply while waiting
+ * for the finger, and the delay between retries. This has to be a wall-clock
+ * budget rather than a retry count: a busy reply comes back in well under a
+ * millisecond, so any small count is exhausted long before a human can reach
+ * the sensor. 0 disables the deadline entirely (retry forever). */
+#define ELAN_BUSY_WAIT_MS 30000
+#define ELAN_BUSY_RETRY_DELAY_MS 20
+
+/* Once frames are being captured, an unbroken run of busy replies this long
+ * means the finger has left the sensor and the swipe is over. */
+#define ELAN_BUSY_LIFT_MS 300
 
