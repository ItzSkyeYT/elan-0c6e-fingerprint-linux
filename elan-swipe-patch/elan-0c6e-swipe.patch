+static int
+elan_busy_wait_ms (FpiDeviceElan *self)
+{
+  (void) self;
+  return elan_opt_int ("FP_ELAN_BUSY_WAIT_MS", ELAN_BUSY_WAIT_MS, 0, 600000);
