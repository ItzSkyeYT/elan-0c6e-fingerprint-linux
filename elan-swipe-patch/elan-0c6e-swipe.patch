+/* ---------------------------------------------------------- debug dump ----
+ *
+ * Raw frames are what the sensor actually returned; the assembled image is
+ * what fpi_assemble_frames made of them. Both are needed to tell "the sensor
+ * streams nothing usable during motion" apart from "the sensor is fine and
+ * the stitcher failed", which is the whole open question for this device.
+ */
+
+static void
+elan_dump_pgm8 (const char          *path,
+                const unsigned char *px,
+                unsigned int         w,
+                unsigned int         h)
+{
+  FILE *f = fopen (path, "wb");
+
+  if (f == NULL)
+    {
+      fp_warn ("cannot write %s: %s", path, g_strerror (errno));
+      return;
+    }
+  fprintf (f, "P5\n%u %u\n255\n", w, h);
+  fwrite (px, 1, (size_t) w * h, f);
+  fclose (f);
+}
+
+/* 16-bit PGM, big-endian samples as the format requires. maxval is declared
+ * as 16383 because that is the sensor's ADC range, not the observed max, so
+ * grey levels stay comparable between frames. */
+static void
+elan_dump_pgm16 (const char           *path,
+                 const unsigned short *px,
+                 unsigned int          w,
+                 unsigned int          h)
+{
+  FILE *f = fopen (path, "wb");
+  unsigned char *be;
+  size_t n = (size_t) w * h;
+
+  if (f == NULL)
+    {
+      fp_warn ("cannot write %s: %s", path, g_strerror (errno));
+      return;
+    }
+  fprintf (f, "P5\n%u %u\n16383\n", w, h);
+  be = g_malloc (n * 2);
+  for (size_t i = 0; i < n; i++)
+    {
+      unsigned short v = px[i] > 16383 ? 16383 : px[i];
+      be[2 * i] = v >> 8;
+      be[2 * i + 1] = v & 0xff;
+    }
+  fwrite (be, 1, n * 2, f);
+  g_free (be);
+  fclose (f);
+}
+
+static void
+elan_dump_append (FpiDeviceElan *self, const char *name, const char *fmt, ...)
+G_GNUC_PRINTF (3, 4);
+
+static void
+elan_dump_append (FpiDeviceElan *self, const char *name, const char *fmt, ...)
+{
+  g_autofree char *path = NULL;
+  g_autofree char *text = NULL;
+  va_list ap;
+  FILE *f;
+
+  if (self->dump_dir == NULL)
+    return;
+
+  va_start (ap, fmt);
+  text = g_strdup_vprintf (fmt, ap);
+  va_end (ap);
+
+  path = g_build_filename (self->dump_dir, name, NULL);
+  f = fopen (path, "a");
+  if (f == NULL)
+    {
+      fp_warn ("cannot append to %s: %s", path, g_strerror (errno));
+      return;
+    }
+  fputs (text, f);
+  fclose (f);
+}
+
+/* One directory per capture attempt: the first attempts are expected to fail
+ * and overwriting them would destroy exactly the evidence being collected. */
+static void
+elan_dump_begin (FpiDeviceElan *self)
+{
+  static int seq = 0;
+  const char *base = g_getenv ("FP_ELAN_DUMP_DIR");
+
+  g_autoptr(GDateTime) now = NULL;
+  g_autofree char *stamp = NULL;
+  g_autofree char *name = NULL;
+
+  g_clear_pointer (&self->dump_dir, g_free);
+  self->dump_t0_us = g_get_monotonic_time ();
+  self->dropped_frames = 0;
+
+  if (base == NULL || *base == '\0')
+    return;
+
+  now = g_date_time_new_now_local ();
+  stamp = g_date_time_format (now, "%Y%m%d-%H%M%S");
+  name = g_strdup_printf ("capture-%s-%03d", stamp, ++seq);
+  self->dump_dir = g_build_filename (base, name, NULL);
+
+  if (g_mkdir_with_parents (self->dump_dir, 0755) != 0)
+    {
+      fp_warn ("cannot create dump dir %s: %s", self->dump_dir,
+               g_strerror (errno));
+      g_clear_pointer (&self->dump_dir, g_free);
+      return;
+    }
+
+  fp_dbg ("dumping this capture to %s", self->dump_dir);
+  elan_dump_append (self, "capture.txt",
+                    "dev_type 0x%04x\nfw_ver 0x%04x\n"
+                    "max_frames %d\nmin_frames %d\nskip_last_frames %d\n"
+                    "skip_calibration %d\nbusy_wait_ms %d\n",
+                    self->dev_type, self->fw_ver,
+                    elan_max_frames (self), elan_min_frames (self),
+                    elan_skip_last_frames (self),
+                    elan_skip_calibration (self) ? 1 : 0,
+                    elan_busy_wait_ms (self));
+}
