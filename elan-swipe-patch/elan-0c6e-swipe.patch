+/* ------------------------------------------------------------- options ----
+ *
+ * The 0c6e (ASUS ROG Flow X13 power button) is a 150x52 strip for which no
+ * working swipe capture has ever been published, so the things worth varying
+ * while testing it are environment variables rather than compiled-in
+ * constants. All are read at the point of use, and none of them changes
+ * behaviour for any other device unless explicitly set.
+ *
+ *   FP_ELAN_DUMP_DIR=DIR       write per-frame and assembled PGMs under DIR
+ *   FP_ELAN_SKIP_CALIBRATION=  1/0 - skip the calibration loop (the
+ *                              background frame is still captured; capture
+ *                              cannot work without it). Defaults to 1 on
+ *                              0c6e, 0 elsewhere.
+ *   FP_ELAN_MAX_FRAMES=N       frames per capture (default 100 on 0c6e)
+ *   FP_ELAN_MIN_FRAMES=N       frames below which a capture is discarded
+ *   FP_ELAN_SKIP_LAST_FRAMES=N frames dropped from the end of the capture
+ *   FP_ELAN_BUSY_WAIT_MS=N     how long to keep retrying a busy pre-scan
+ *                              reply while waiting for a finger (0 = forever)
+ *   FP_ELAN_PARTIAL=0          clear FPI_IMAGE_PARTIAL so that NBIS keeps
+ *                              perimeter minutiae
+ */
+
+static gboolean
+elan_opt_bool (const char *name, gboolean fallback)
+{
+  const char *v = g_getenv (name);
+
+  if (v == NULL || *v == '\0')
+    return fallback;
+
+  if (g_ascii_strcasecmp (v, "0") == 0 ||
+      g_ascii_strcasecmp (v, "no") == 0 ||
+      g_ascii_strcasecmp (v, "off") == 0 ||
+      g_ascii_strcasecmp (v, "false") == 0)
+    return FALSE;
+
+  return TRUE;
+}
+
+static int
+elan_opt_int (const char *name, int fallback, int min, int max)
+{
+  const char *v = g_getenv (name);
+  char *end = NULL;
+  gint64 n;
+
+  if (v == NULL || *v == '\0')
+    return fallback;
+
+  n = g_ascii_strtoll (v, &end, 10);
+  if (end == v || *end != '\0' || n < min || n > max)
+    {
+      fp_warn ("%s=\"%s\" is not an integer in [%d, %d]; using %d",
+               name, v, min, max, fallback);
+      return fallback;
+    }
+
+  return (int) n;
+}
