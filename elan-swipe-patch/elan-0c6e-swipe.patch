+static int
+elan_skip_last_frames (FpiDeviceElan *self)
+{
+  return elan_opt_int ("FP_ELAN_SKIP_LAST_FRAMES", ELAN_SKIP_LAST_FRAMES,
+                       0, elan_max_frames (self) - 1);
