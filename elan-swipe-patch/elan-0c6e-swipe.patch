+
+/* Whether to skip the calibration loop. On fw 0x0161 (the ROG Flow X13)
+ * calibration reports success -- delta 347 against a max of 500 -- and
+ * capture then fails anyway, so historically it was skipped for this PID.
+ * That has never been re-verified, hence the override: FP_ELAN_SKIP_CALIBRATION=0
+ * forces calibration back on so both can be tested in one session. */
+static gboolean
+elan_skip_calibration (FpiDeviceElan *self)
+{
+  return elan_opt_bool ("FP_ELAN_SKIP_CALIBRATION",
+                        self->dev_type == ELAN_0C6E);
+}
